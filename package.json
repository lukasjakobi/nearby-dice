{
  "name": "nearby-dice",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/work-sans": "^0.4.2",
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "i18next": "^26.5.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.4",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "^1.64.1",
    "@react-native/jest-preset": "0.88.0",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/react-native-web-vite": "^10.6.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "eslint": "^10.13.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "storybook": "^10.6.2",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3",
    "vite": "^7.3.7"
  },
  "scripts": {
    "dev": "expo start",
    "web": "expo start --web",
    "web:shot": "node scripts/web-shot.mjs",
    "storybook": "storybook dev --port 6006",
    "storybook:build": "storybook build --output-dir storybook-static",
    "ios": "expo run:ios",
    "android": "expo run:android --app-id io.jakobi.nearbydice.dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "playwright test",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:names": "! git grep -n -i -I \"kni[f]fel\"",
    "check": "npm run check:names && npm run typecheck && npm run lint && npm run format:check && npm test",
    "check:release-bundle": "node scripts/check-release-bundle.mjs",
    "sounds": "node scripts/generate-sounds.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "doctor": "expo-doctor"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/modules/.*/build",
      "<rootDir>/.claude/worktrees/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.after-env.ts"
    ]
  },
  "overrides": {
    "zod": "^4.6.7",
    "node-forge": "^1.4.2"
  }
}
