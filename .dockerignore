# VCS, editor and local agent state.
**/.git
**/.DS_Store
**/._*
**/Thumbs.db
**/Desktop.ini
**/.idea
**/.vscode
/.claude
/.impeccable

# Install dependencies inside the image from package.json and package-lock.json.
**/node_modules

# Expo / Metro state and generated exports.
**/.expo
/dist
/web-build
/expo-env.d.ts
**/.metro-health-check*

# Regenerate root native projects in the image when needed.
# Preserve the maintained Android / iOS sources in modules/.
/android
/ios
**/.kotlin
**/.gradle
**/.cxx
**/.externalNativeBuild
/modules/*/build
/modules/*/android/build
/modules/*/android/local.properties
/modules/*/ios/build
/modules/*/ios/Pods
**/DerivedData
**/xcuserdata
**/*.xcuserstate
**/*.apk
**/*.aab
**/*.ipa
**/*.hprof

# Credentials never belong in the build context; inject them at build/run time.
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
**/*.jks
**/*.keystore
**/*.p8
**/*.p12
**/*.pfx
**/*.key
**/*.pem
**/*.mobileprovision
**/credentials.json

# Test output and tool caches; keep test sources and configuration.
**/coverage
**/.nyc_output
**/.cache
**/.eslintcache
**/.prettiercache
**/*.tsbuildinfo

# Logs, editor backups and merge leftovers.
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/*.swp
**/*.swo
**/*~
**/*.orig
**/*.orig.*
**/*.rej
